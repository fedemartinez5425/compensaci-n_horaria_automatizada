# ─────────────────────────────────────────────────────────────────
# .streamlit/secrets.toml
# ─────────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Creá la carpeta .streamlit/ dentro de la carpeta del proyecto
#   2. Copiá este archivo como secrets.toml dentro de esa carpeta
#   3. Completá los valores con tus credenciales reales
#   4. NUNCA subas este archivo a GitHub
# ─────────────────────────────────────────────────────────────────

# ID del Google Sheet (lo encontrás en la URL del sheet):
# https://docs.google.com/spreadsheets/d/TU_SHEET_ID_AQUI/edit
SHEET_ID = "TU_SHEET_ID_AQUI"

# Contraseñas de arranque. Solo se usan si la hoja 'config_app' todavía
# no tiene contraseñas cargadas. Después se cambian desde el Panel RRHH.
PASSWORD_GUARDIA_INICIAL = "elegí-una-clave"
PASSWORD_RRHH_INICIAL    = "elegí-otra-clave"

# Credenciales de la cuenta de servicio de Google Cloud
[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto-id"
private_key_id = "XXXXXXXXXXXX"
private_key = "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
client_email = "permisos-app@tu-proyecto.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/permisos-app%40tu-proyecto.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
